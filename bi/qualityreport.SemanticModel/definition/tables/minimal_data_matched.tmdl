table minimal_data_matched
	lineageTag: ee2f18da-1467-4d57-b5ec-06d75edacebb

	measure 'ATM B MAE' =
			
			AVERAGEX(
			    minimal_data_matched,
			    ABS(minimal_data_matched[pm25_atm_b] - minimal_data_matched[pm25_nowcast_value])
			)
		lineageTag: fc86ce62-b9ec-47ef-9ae6-5949758cc47f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure correl_atm_a_to_airnow =
			
			VAR AvgX =
			    AVERAGE(minimal_data_matched[pm25_atm_a])
			VAR AvgY =
			    AVERAGE(minimal_data_matched[pm25_nowcast_value])
			VAR Numerator =
			    SUMX(
			        minimal_data_matched,
			        (minimal_data_matched[pm25_atm_a] - AvgX)
			            * (minimal_data_matched[pm25_nowcast_value] - AvgY)
			    )
			VAR DenominatorX =
			    SUMX(
			        minimal_data_matched,
			        POWER(minimal_data_matched[pm25_atm_a] - AvgX, 2)
			    )
			VAR DenominatorY =
			    SUMX(
			        minimal_data_matched,
			        POWER(minimal_data_matched[pm25_nowcast_value] - AvgY, 2)
			    )
			RETURN
			    DIVIDE(
			        Numerator,
			        SQRT(DenominatorX * DenominatorY)
			    )
		lineageTag: e4281b2a-a489-417e-bb73-6b765f223a78

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure correl_atm_b_to_airnow =
			
			VAR AvgX =
			    AVERAGE(minimal_data_matched[pm25_atm_b])
			VAR AvgY =
			    AVERAGE(minimal_data_matched[pm25_nowcast_value])
			VAR Numerator =
			    SUMX(
			        minimal_data_matched,
