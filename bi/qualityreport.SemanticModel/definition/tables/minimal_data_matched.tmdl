	column pm25_bin_id =
			
			SWITCH(
			    TRUE(),
			    minimal_data_matched[pm25_nowcast_value] < 5, 1,
			    minimal_data_matched[pm25_nowcast_value] < 10, 2,
			    minimal_data_matched[pm25_nowcast_value] < 25, 3,
			    minimal_data_matched[pm25_nowcast_value] < 50, 4,
			    minimal_data_matched[pm25_nowcast_value] < 100, 5,
			    minimal_data_matched[pm25_nowcast_value] < 150, 6,
			    minimal_data_matched[pm25_nowcast_value] < 200, 7,
			    8
			)
		formatString: 0
		lineageTag: 4ce11c9a-089c-48f0-bc92-50ca350fb868
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column distance_category_id =
			
			SWITCH(
			    TRUE(),
			    minimal_data_matched[dist_miles] <= 0.1, 1,
			    minimal_data_matched[dist_miles] <= 0.5, 2,
			    minimal_data_matched[dist_miles] <= 1.0, 3,
			    minimal_data_matched[dist_miles] <= 5.0, 4,
			    BLANK()
			)
		formatString: 0
		lineageTag: d5ccba76-6960-45cf-8b0b-49fab641d8f8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column humidity_bin_id =
			
			SWITCH(
			    TRUE(),
			    minimal_data_matched[humidity] < 20, 1,
			    minimal_data_matched[humidity] < 40, 2,
			    minimal_data_matched[humidity] < 60, 3,
			    minimal_data_matched[humidity] < 80, 4,
			    5
			)
		formatString: 0
		lineageTag: 096a4e48-faa3-4f54-b071-f54a1eafde3d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column test_mae_a =
			
			minimal_data_matched[pm25_atm_a]
			-
			minimal_data_matched[pm25_nowcast_value]
		lineageTag: d0c6fb94-babd-42ec-9217-f4bae49856cc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column atm_a_b_difference =
			
			ABS(
			    minimal_data_matched[pm25_atm_a]
			    -
			    minimal_data_matched[pm25_atm_b]
			)
		lineageTag: c9af6d35-2314-48ff-8f44-729241cea667
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition minimal_data_matched = calculated
		mode: import
		source =
				
				FILTER(data_matched, data_matched[pm25_atm_a] < MAX(airnow_cleaned[pm25_nowcast_value]) && data_matched[pm25_atm_b] < MAX(airnow_cleaned[pm25_nowcast_value]) && data_matched[pm25_cf_1_a] < MAX(airnow_cleaned[pm25_nowcast_value]) && data_matched[pm25_cf_1_b] < MAX(airnow_cleaned[pm25_nowcast_value]))

	annotation PBI_Id = f33f672464a2453fad741070dc1531ba

