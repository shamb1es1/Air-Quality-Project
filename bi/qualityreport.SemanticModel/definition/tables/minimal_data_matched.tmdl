			        POWER(minimal_data_matched[pm25_nowcast_value] - AvgY, 2)
			    )
			RETURN
			    DIVIDE(
			        Numerator,
			        SQRT(DenominatorX * DenominatorY)
			    )
		lineageTag: 24872f62-625a-443e-9b89-b3e609e65d37

		annotation PBI_FormatHint = {"isGeneralNumber":true}

