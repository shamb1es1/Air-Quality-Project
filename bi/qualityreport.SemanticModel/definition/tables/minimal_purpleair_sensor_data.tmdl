	partition minimal_purpleair_sensor_data = calculated
		mode: import
		source =
				
				FILTER(
				    purpleair_cleaned,
				    purpleair_cleaned[pm25_atm_a] <= MAX(airnow_cleaned[pm25_nowcast_value]) &&
				    purpleair_cleaned[pm25_atm_b] <= MAX(airnow_cleaned[pm25_nowcast_value]) &&
				    purpleair_cleaned[pm25_cf_1_a] <= MAX(airnow_cleaned[pm25_nowcast_value]) &&
				    purpleair_cleaned[pm25_cf_1_b] <= MAX(airnow_cleaned[pm25_nowcast_value])
				)

	annotation PBI_Id = ae75f8171e874539ba5a04f9117be66d

